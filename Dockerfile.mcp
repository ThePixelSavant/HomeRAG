FROM python:3.12-slim

# Non-root: this is the process the local model talks to over HTTP, so it is
# the one an injection would land in. It holds no key and has no vault mount,
# and now no root either.
ARG RAG_UID=1000
ARG RAG_GID=1000

WORKDIR /app

# Models are baked in rather than downloaded on first use: deterministic
# builds, no network dependency at runtime, and no first-request latency cliff.
ENV FASTEMBED_CACHE_PATH=/models

COPY requirements.mcp.txt .
RUN pip install --no-cache-dir -r requirements.mcp.txt

COPY app/ app/
COPY sources.yaml .

RUN groupadd -g "$RAG_GID" app \
    && useradd -u "$RAG_UID" -g "$RAG_GID" -m -s /usr/sbin/nologin app \
    && mkdir -p /models \
    && chown -R "$RAG_UID:$RAG_GID" /app /models

USER app

RUN python -c "from app.pipeline.embedder import warm_cache; warm_cache()"

CMD ["python", "-m", "app.main"]
