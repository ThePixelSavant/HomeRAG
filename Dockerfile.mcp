FROM python:3.12-slim

WORKDIR /app

# Models are baked in rather than downloaded on first use: deterministic
# builds, no network dependency at runtime, and no first-request latency cliff.
ENV FASTEMBED_CACHE_PATH=/models

COPY requirements.mcp.txt .
RUN pip install --no-cache-dir -r requirements.mcp.txt

COPY app/ app/
COPY sources.yaml .

RUN python -c "from app.pipeline.embedder import warm_cache; warm_cache()"

CMD ["python", "-m", "app.main"]
