# Vault-only settings. Copy to .env.vault (mode 600). Only mcp-vault reads
# this file: docker-compose.yml gives it to no other service, and
# tests/test_compose.py fails if one gets it. The worker and mcp-server handle
# untrusted input and have no use for the identity secret.
#
# === Vault access control ===
# Must equal FORWARD_USER_INFO_HEADER_JWT_SECRET in ~/Dev/LLM/.env -- this is
# what lets mcp-vault verify who is asking. Generate with: openssl rand -hex 32
# Without it, every model-initiated vault call is denied.
#
# Open WebUI also needs ENABLE_FORWARD_USER_INFO_HEADERS=true. The secret on
# its own sends nothing: the assertion is minted inside a block guarded by that
# flag, so the calls arrive with no identity and are denied as if the secret
# were wrong. See README.md "Connecting Open WebUI" for the full set.
VAULT_JWT_SECRET=
# Must match the email on the Open WebUI account, and the role must be in
# VAULT_ALLOWED_ROLES. An empty allowlist denies everyone, deliberately.
VAULT_ALLOWED_EMAILS=you@example.com
VAULT_ALLOWED_ROLES=admin
# How long an unlocked vault stays unlocked.
VAULT_KEY_TTL_SECONDS=900
# How long an UNapproved request waits for a human. Short on purpose: a
# prompt-injected request should not linger hoping for a distracted rubber
# stamp.
VAULT_GRANT_TTL_SECONDS=120
# How long an APPROVED grant stays redeemable, measured from the approval.
# This has to cover returning to the chat, re-asking, and the local model
# prefilling and generating -- at ~15 t/s that does not fit in 120s, and a
# single clock from creation made approvals unredeemable in practice.
VAULT_REDEEM_TTL_SECONDS=300

