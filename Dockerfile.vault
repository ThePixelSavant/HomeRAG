FROM python:3.12-slim

# Runs as the host user, like the other three. It was the last one on root, and
# that broke vault ingestion outright: the unprivileged ingestion worker must
# read vault.salt and vault.verifier and write vault.db and blobs/, and
# root-owned 0600 files shut it out.
#
# The control socket does NOT move with the files. It lives on a tmpfs inside
# this container (/run/vault, see docker-compose.yml), not on the ./data/vault
# bind mount: the worker runs as the same uid and mounts that directory, so a
# socket there would be reachable from the process that parses untrusted
# files. `make unlock` and every vault CLI command run here via `docker exec`.
ARG RAG_UID=1000
ARG RAG_GID=1000

WORKDIR /app

ENV FASTEMBED_CACHE_PATH=/models

COPY requirements.vault.txt .
RUN pip install --no-cache-dir -r requirements.vault.txt

COPY app/ app/
COPY sources.yaml .

RUN groupadd -g "$RAG_GID" app \
    && useradd -u "$RAG_UID" -g "$RAG_GID" -m -s /usr/sbin/nologin app \
    && mkdir -p /models \
    && chown -R "$RAG_UID:$RAG_GID" /app /models

USER app

RUN python -c "from app.pipeline.embedder import warm_cache; warm_cache()"

CMD ["python", "-m", "app.vault_server"]
