# === Embedding model ===
# FROZEN at index creation — changing this requires: make rebuild-index
# All chunks must share one embedding space; silently mixing models corrupts retrieval.
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# === Qdrant collection ===
COLLECTION_NAME=docs

# === MCP server ===
MCP_PORT=8000

# === Local document ingestion ===
# Absolute path on the host to bind-mount read-only as /docs in the ingestion worker
LOCAL_DOCS_PATH=/home/you/Documents

# === Open WebUI note ===
# Set WEBUI_SECRET_KEY in ~/Dev/LLM/.env and keep it stable across restarts.
# If it changes, Open WebUI invalidates all saved tool credentials on next restart.
# Generate a value with: openssl rand -hex 32
# Do NOT set it here — it belongs in the LLM stack's .env file.
