# === Embedding ===
# FROZEN at collection creation. Changing either requires: make rebuild-index
# A fingerprint stored alongside the vectors enforces this -- note that dimension
# alone cannot catch a model swap, since bge-base, nomic-v1.5, gte-base and
# arctic-m are all 768-dim.
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# onnxruntime defaults to one thread per core and will thrash against
# llama-server, which already saturates this box.
EMBED_THREADS_INGEST=8
EMBED_THREADS_QUERY=4
FASTEMBED_CACHE_PATH=/models

# === Qdrant (open tier) ===
COLLECTION_NAME=docs
# Set once Qdrant is reachable off localhost. The worker needs the read-write
# key; mcp-server should be given the read-only one.
# QDRANT_API_KEY=

# === Chunking (tokens, measured with the embedding model's own tokenizer) ===
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=64
CHUNK_MAX_TOKENS=480

# === MCP servers ===
MCP_PORT=8000
VAULT_PORT=8001

# === Host paths (bind-mounted; keep everything under one rsync-able tree) ===
RAG_DATA_ROOT=./data
LOCAL_DOCS_PATH=/home/you/Dev
CLAUDE_PROJECTS_PATH=/home/you/.claude/projects

# === Vault access control ===
# Must equal FORWARD_USER_INFO_HEADER_JWT_SECRET in ~/Dev/LLM/.env -- this is
# what lets mcp-vault verify who is asking. Generate with: openssl rand -hex 32
# Without it, every model-initiated vault call is denied.
VAULT_JWT_SECRET=
# Only these identities may reach vault data, and only via an approved request.
VAULT_ALLOWED_EMAILS=you@example.com
VAULT_ALLOWED_ROLES=admin
# How long an unlocked vault stays unlocked, and how long a single-use
# per-request grant remains redeemable.
VAULT_KEY_TTL_SECONDS=900
VAULT_GRANT_TTL_SECONDS=120

# NOTE: the vault passphrase is deliberately NOT here and never on disk.
# `make unlock` prompts for it on a TTY; the derived key lives only in memory.

# === Vision model (receipt extraction) ===
LLAMA_URL=http://llama-server:8080

# === Open WebUI note ===
# Set WEBUI_SECRET_KEY and FORWARD_USER_INFO_HEADER_JWT_SECRET in ~/Dev/LLM/.env
# and keep them stable. If WEBUI_SECRET_KEY changes, Open WebUI invalidates every
# saved tool-server registration on the next restart.
# Do NOT set them here -- they belong to the LLM stack.
