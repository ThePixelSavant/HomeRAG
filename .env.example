# === Embedding ===
# FROZEN at collection creation. Changing either requires: make rebuild-index
# A fingerprint stored alongside the vectors enforces this -- note that dimension
# alone cannot catch a model swap, since bge-base, nomic-v1.5, gte-base and
# arctic-m are all 768-dim.
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# onnxruntime defaults to one thread per core and will thrash against
# llama-server, which already saturates this box.
EMBED_THREADS_INGEST=8
EMBED_THREADS_QUERY=4
FASTEMBED_CACHE_PATH=/models

# === Qdrant (open tier) ===
COLLECTION_NAME=docs
# Both required: compose refuses to start without them. llm-net is shared with
# open-webui and llama-server, and an unauthenticated Qdrant let them read every
# open-tier chunk around mcp-server's client tokens. The worker gets the
# read-write key; mcp-server and rag-admin only the read-only one.
# Generate each with: openssl rand -hex 32
QDRANT_API_KEY=
QDRANT_READ_ONLY_API_KEY=

# === Chunking (tokens, measured with the embedding model's own tokenizer) ===
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=64
CHUNK_MAX_TOKENS=480

# === MCP servers ===
MCP_PORT=8000
VAULT_PORT=8001
# Approved clients of the open-tier server (ADR-033), as name:token pairs.
# Each client sends its token as `Authorization: Bearer <token>`; anything else
# gets a 401. Unset and every request is refused. One token per client, so one
# can be revoked alone; at least 32 characters each (openssl rand -hex 32).
# After changing it: docker compose up -d mcp-server (a restart does not
# re-read .env).
MCP_CLIENT_TOKENS=open-webui:<openssl rand -hex 32>,claude-code:<openssl rand -hex 32>

# === Admin dashboard (rag-admin, ADR-031) ===
# Read-only dashboard at http://127.0.0.1:8090. Log in with this token; curl
# sends it as `Authorization: Bearer`. Unset, or under 32 characters, and every
# page answers 404. Generate with: openssl rand -hex 32
REPORT_TOKEN=
# Host loopback port the dashboard is published on.
ADMIN_PORT=8090

# === Host paths (bind-mounted; keep everything under one rsync-able tree) ===
RAG_DATA_ROOT=./data
LOCAL_DOCS_PATH=/home/you/Dev
CLAUDE_PROJECTS_PATH=/home/you/.claude/projects

# === Vault access control ===
# Lives in .env.vault (copy .env.vault.example), which only mcp-vault reads.
# Not here: the worker and mcp-server receive this file, and both handle
# untrusted input. They have no use for the identity secret.

# NOTE: the vault passphrase is deliberately NOT here and never on disk.
# `make unlock` prompts for it on a TTY; the derived key lives only in memory.

# === Vision model (receipt extraction) ===
LLAMA_URL=http://llama-server:8080
# The router model id receipts are read with (see ~/Dev/LLM's models preset).
VISION_MODEL=qwen3-vl

# === Open WebUI note ===
# Set WEBUI_AUTH, WEBUI_SECRET_KEY, ENABLE_FORWARD_USER_INFO_HEADERS and
# FORWARD_USER_INFO_HEADER_JWT_SECRET in ~/Dev/LLM/.env and keep them stable.
# WEBUI_SECRET_KEY in particular: Open WebUI auto-generates one OUTSIDE its data
# volume, so it changes on any container recreate, and every saved tool-server
# registration stops working. Pin it explicitly.
# Do NOT set them here -- they belong to the LLM stack. Step-by-step
# instructions live in ~/Dev/LLM/HANDOFF-rag-integration.md.

# === Backups (ADR-032) ===
# Local bundles kept in data/backups/. The off-machine side (restic) is NOT
# configured here: its password must never be in this file, which the worker
# container receives whole. See docs/cli.md, `rag backup`.
BACKUP_KEEP_LOCAL=7
