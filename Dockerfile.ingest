FROM python:3.12-slim

# Runs as a normal user, not root. This container opens untrusted input --
# PDFs from the internet, transcripts, anything dropped in the inbox -- so it
# is the last one that should have root inside its namespace.
#
# It also writes to bind-mounted ./data, and a root process there produces
# root-owned files on the HOST. That is what made documents copied in by
# `make add` uneditable without sudo.
#
# RAG_UID/RAG_GID must match the host user that owns ./data, or the writes
# fail. 1000:1000 is the first regular user on most systems; override at build
# time if yours differs:  docker compose build --build-arg RAG_UID=$(id -u)
ARG RAG_UID=1000
ARG RAG_GID=1000

WORKDIR /app

ENV FASTEMBED_CACHE_PATH=/models

# poppler-utils provides pdftotext, the text-native PDF path. OCR tooling
# (tesseract, ocrmypdf, ghostscript) lands here in Phase 2 -- this image only,
# never the MCP or vault images.
RUN apt-get update \
    && apt-get install -y --no-install-recommends poppler-utils \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.ingest.txt .
RUN pip install --no-cache-dir -r requirements.ingest.txt

COPY app/ app/
COPY sources.yaml .
# `make test` runs the suite in this image, so it needs the tests.
COPY tests/ tests/
COPY pyproject.toml .

# Create the user and hand it the two directories it writes to: /app (pytest
# drops its cache there) and /models (the embedding cache). Done before the
# model download so the cached files are owned by the user that will read
# them, rather than by root.
RUN groupadd -g "$RAG_GID" app \
    && useradd -u "$RAG_UID" -g "$RAG_GID" -m -s /usr/sbin/nologin app \
    && mkdir -p /models \
    && chown -R "$RAG_UID:$RAG_GID" /app /models

USER app

RUN python -c "from app.pipeline.embedder import warm_cache; warm_cache()"

ENTRYPOINT ["python", "-m", "app.ingest"]
CMD ["status"]
